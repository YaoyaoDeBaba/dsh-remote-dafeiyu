{
  "name": "dsh-remote-dafeiyu",
  "version": "0.7.0-dafeiyu.2",
  "description": "DSH Remote Control（大肥鱼定制）：在官方插件基础上加改名/模型切换两条能力，并在设置页提供手机 App 扫码下载。",
  "type": "module",
  "license": "MIT",
  "author": "dsh-remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaoyaoDeBaba/dsh-remote-dafeiyu.git"
  },
  "homepage": "https://github.com/YaoyaoDeBaba/dsh-remote-dafeiyu#readme",
  "bugs": "https://github.com/YaoyaoDeBaba/dsh-remote-dafeiyu/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "remote-control",
    "relay",
    "websocket",
    "wechat",
    "miniprogram",
    "e2e-encryption",
    "cordis",
    "plugin",
    "qrcode"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/bundle/index.js",
  "exports": {
    ".": "./dist/bundle/index.js",
    "./client": "./dist/bundle/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "copy",
    "dist/bundle",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.client.json",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/bundle-plugin.mjs",
    "test": "pnpm build && node --test \"dist/tests/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@dsh-remote/protocol": "github:YaoyaoDeBaba/dsh-remote-protocol#53d3c1e473f30532f692cfaf729e0423c40e2d5d",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@11.7.0",
  "icon": "./icon.svg"
}